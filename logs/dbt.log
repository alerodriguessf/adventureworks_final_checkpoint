        create or replace table `ted_dev`.`db_gold`.`dim_salesperson`
      
      
  using delta
      
      
      
      
      
      
      
      as
      with base as (
    select *
    from `ted_dev`.`db_silver`.`stg_sales_person_details`
),

final as (
    select
        sales_person_id,

        trim(
            concat_ws(' ',
                coalesce(first_name, ''),
                coalesce(middle_name, ''),
                coalesce(last_name, '')
            )
        ) as full_name,

        job_title,
        email_address,
        regexp_replace(phone_number, '-', '') as phone_number,

        sales_quota,
        sales_ytd,
        sales_last_year,

        territory_id,
        territory_group,

        case
            when sales_quota > 0 then round((sales_ytd / sales_quota) * 100, 2)
            else null
        end as pct_quota_hit

    from base
)

select * from final
  
