        create or replace table `ted_dev`.`db_gold`.`fact_demand_forecast_weekly`
      
      
  using delta
      
      
      
      
      
      
      
      as
      with orders as (
    select
        -- Chaves / datas
        cast(order_date as date)                 as order_date,
        order_id,
        cast(product_id as int)                  as product_id,
        cast(territory_id as int)                as territory_id,

        -- Medidas brutas (sanitizadas)
        greatest(coalesce(order_quantity, 0), 0) as order_quantity,
        coalesce(is_online_order, false)         as is_online_order,
        coalesce(gross_revenue_usd, 0.0)         as gross_revenue_usd
    from `ted_dev`.`db_gold`.`fact_sales_order`
),

products as (
    select
        cast(product_id as int)       as product_id,
        coalesce(product_name, 'N/A') as product_name,
        product_line,
        product_class,
        product_style
    from `ted_dev`.`db_gold`.`dim_product`
),

dates as (
    select
        cast(date_day as date) as date_day,
        year,
        month,
        quarter,
        day_of_week,
        is_weekend,

        -- buckets úteis para forecast
        week_of_year,
        date_trunc('week', date_day)::date        as week_start_date,
        (date_trunc('month', date_day)
          + interval '1 month'
          - interval '1 day')::date              as month_end_date
    from `ted_dev`.`db_gold`.`dim_date`
),

territories as (
    select
        cast(territory_id as int)    as territory_id,
        coalesce(territory_name,'N/A') as territory_name,
        coalesce(country_region_code,'N/A') as country_region_code
    from `ted_dev`.`db_gold`.`dim_territory`
),

joined as (
    select
        o.order_date,
        o.order_id,
        o.product_id,
        p.product_name,
        p.product_line,
        p.product_class,
        p.product_style,

        o.territory_id,
        t.territory_name,
        t.country_region_code,

        d.year,
        d.month,
        d.quarter,
        d.day_of_week,
        d.is_weekend,

        -- buckets de tempo auxiliares
        d.week_of_year,
        d.week_start_date,
        d.month_end_date,

        -- medidas brutas
        o.order_quantity,
        o.is_online_order,
        o.gross_revenue_usd
    from orders o
    left join products    p on o.product_id   = p.product_id
    left join dates       d on o.order_date   = d.date_day
    left join territories t on o.territory_id = t.territory_id
),


aggregated as (
    select
        order_date,
        product_id,
        product_name,
        product_line,
        product_class,
        product_style,

        territory_id,
        territory_name,
        country_region_code,

        year,
        month,
        quarter,
        day_of_week,
        is_weekend,

        week_of_year,
        week_start_date,
        month_end_date,

        -- medidas agregadas
        sum(order_quantity)                         as total_items_sold,
        count(distinct order_id)                    as total_orders,
        sum(gross_revenue_usd)                      as total_gross_revenue,

        -- flags informativas
        bool_or(is_online_order)                    as any_online_order
    from joined
    -- garantia de não nulos essenciais
    where order_date is not null
      and product_id is not null
      and territory_id is not null
    group by
        order_date,
        product_id,
        product_name,
        product_line,
        product_class,
        product_style,
        territory_id,
        territory_name,
        country_region_code,
        year,
        month,
        quarter,
        day_of_week,
        is_weekend,
        week_of_year,
        week_start_date,
        month_end_date
)

select *
from aggregated
order by
    order_date, product_id, territory_id
  
