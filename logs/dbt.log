        create or replace table `ted_dev`.`db_gold`.`fact_demand_forecast_weekly`
      
      
  using delta
      
      
      
      
      
      
      
      as
      with orders as (
    select
        order_date,
        order_id,
        product_id,
        territory_id,
        order_quantity,
        is_online_order,
        gross_revenue_usd
    from `ted_dev`.`db_gold`.`fact_sales_order`
),

products as (
    select
        product_id,
        product_name,
        product_line,
        product_class,
        product_style
    from `ted_dev`.`db_gold`.`dim_product`
),

dates as (
    select
        date_day,
        year,
        month,
        quarter,
        day_of_week,
        is_weekend
    from `ted_dev`.`db_gold`.`dim_date`
),

customers as (
    select
        territory_id,
        territory_name,
        country_region_code
    from `ted_dev`.`db_gold`.`dim_costumer`
),

aggregated as (
    select
        o.order_date,
        o.product_id,
        p.product_name,
        p.product_line,
        p.product_class,
        p.product_style,
        o.territory_id,
        c.territory_name,
        c.country_region_code,
        d.year,
        d.month,
        d.quarter,
        d.day_of_week,
        d.is_weekend,
        sum(o.order_quantity) as total_items_sold,
        count(distinct order_id) as total_orders,
        sum(o.gross_revenue_usd) as total_gross_revenue
    from orders o
    left join products p
        on o.product_id = p.product_id
    left join dates d
        on o.order_date = d.date_day
    left join customers c
        on o.territory_id = c.territory_id
    group by
        o.order_date,
        o.product_id,
        p.product_name,
        p.product_line,
        p.product_class,
        p.product_style,
        o.territory_id,
        c.territory_name,
        c.country_region_code,
        d.year,
        d.month,
        d.quarter,
        d.day_of_week,
        d.is_weekend
    order by
        o.order_date,
        o.product_id,
        o.territory_id
)

select * from aggregated
  
