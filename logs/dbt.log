        create or replace table `ted_dev`.`db_gold`.`fact_demand_forecast_weekly`
      
      
  using delta
      
      
      
      
      
      
      
      as
      with order_detail as (
    select *
    from `ted_dev`.`db_silver`.`stg_sales_order_detail`
),

order_header as (
    select *
    from `ted_dev`.`db_silver`.`stg_sales_order_header`
),

currency_rate as (
    select *
    from `ted_dev`.`db_silver`.`stg_sales_currency_rate`
),

-- loja e endereço (usados depois para enriquecer)
stg_store as (
  select
    business_entity_id as store_id,
    store_name
  from `ted_dev`.`db_silver`.`stg_sales_store`
),

stg_store_addresses as (
  select
    business_entity_id,
    address_line_1,
    city,
    state_province_name,
    postal_code,
    country_region_name
  from `ted_dev`.`db_silver`.`stg_sales_storewithaddresses`
),

-- produto 
stg_product as (
  select *
  from `ted_dev`.`db_silver`.`stg_production_product_details`
),

-- joined: replica a sua lógica de conversão e colunas chave
joined as (
    select
        -- IDs principais
        od.order_id,
        od.order_detail_id,

        -- Produto e oferta
        od.product_id,

        -- Cliente e vendedor / território
        oh.customer_id,
        oh.sales_person_id,
        oh.territory_id,

        -- Datas relevantes
        oh.order_date,
        oh.due_date,
        oh.ship_date,

        -- Informações de envio e pagamento
        oh.ship_method_id,
        oh.currency_rate_id,

        -- Quantidade e preço originais
        od.order_quantity,
        od.unit_price,
        od.unit_price_discount,
        od.line_total,

        -- Valor convertido para USD (se tiver currency_rate, multiplica; se não, já está em USD)
        case 
            when oh.currency_rate_id is not null and cr.average_rate is not null
                 then od.unit_price * cr.average_rate
            else od.unit_price
        end as unit_price_usd,

        -- Receita bruta ajustada em USD (segue mesma lógica)
        case 
            when oh.currency_rate_id is not null and cr.average_rate is not null
                 then od.order_quantity * (od.unit_price * cr.average_rate) * (1 - coalesce(od.unit_price_discount,0))
            else od.order_quantity * od.unit_price * (1 - coalesce(od.unit_price_discount,0))
        end as gross_revenue_usd,

        -- Receita bruta ajustada original (sem considerar impostos ou frete)
        (od.order_quantity * od.unit_price * (1 - coalesce(od.unit_price_discount,0))) as gross_revenue,

        -- Flags e rastreabilidade
        oh.is_online_order,
        current_timestamp() as ingestion_timestamp

    from order_detail od
    left join order_header oh
        on od.order_id = oh.order_id
    left join currency_rate cr
        on oh.currency_rate_id = cr.currency_rate_id
),

-- enrich store info
store_enriched as (
  select
    s.store_id,
    s.store_name,
    a.address_line_1,
    a.city,
    a.state_province_name,
    a.postal_code,
    a.country_region_name
  from stg_store s
  left join stg_store_addresses a
    on s.store_id = a.business_entity_id
),

-- agregação semanal (week_start) por produto + loja
weekly_agg as (
  select
    date_trunc('week', order_date) as week_start,
    product_id,
    coalesce(store_id, null) as store_id, -- se não existir store, deixar nulo para agregar por território depois
    territory_id,
    -- manter produto/enriquecimento
    max(product_name) as product_name,
    max(product_category) as product_category,
    max(is_glove) as is_glove,

    sum(coalesce(order_quantity,0)) as units_sold,
    sum(coalesce(gross_revenue_usd,0)) as revenue_usd,
    sum(coalesce(gross_revenue,0)) as revenue_orig,
    case when sum(coalesce(order_quantity,0)) = 0 then null
         else sum(coalesce(gross_revenue_usd,0)) / sum(coalesce(order_quantity,0))
    end as avg_unit_price_usd,
    max(is_online_order) as is_online_order,
    max(ingestion_timestamp) as ingestion_timestamp

  from joined_enriched
  group by 1,2,3,4
),

-- features: lags e médias móveis (baseline)
features as (
  select
    week_start,
    product_id,
    store_id,
    territory_id,
    product_name,
    product_category,
    is_glove,
    units_sold,
    revenue_usd,
    revenue_orig,
    avg_unit_price_usd,
    is_online_order,
    ingestion_timestamp,

    -- lags (em semanas)
    lag(units_sold, 1) over (partition by product_id, store_id order by week_start) as lag_1w,
    lag(units_sold, 2) over (partition by product_id, store_id order by week_start) as lag_2w,

    -- médias móveis: 4 semanas e 12 semanas (janela incluindo a semana atual)
    avg(units_sold) over (partition by product_id, store_id order by week_start
                          rows between 3 preceding and current row) as ma_4w,
    avg(units_sold) over (partition by product_id, store_id order by week_start
                          rows between 11 preceding and current row) as ma_12w

  from weekly_agg
)

select
  week_start,
  product_id,
  product_name,
  product_category,
  store_id,
  territory_id,
  is_glove,
  units_sold,
  revenue_usd,
  revenue_orig,
  avg_unit_price_usd,
  is_online_order,
  lag_1w,
  lag_2w,
  ma_4w,
  ma_12w,
  ingestion_timestamp,
  se.store_name,
  se.address_line_1,
  se.city,
  se.state_province_name,
  se.postal_code,
  se.country_region_name
from features f
left join store_enriched se
  on f.store_id = se.store_id
order by week_start desc, product_id, store_id
  
