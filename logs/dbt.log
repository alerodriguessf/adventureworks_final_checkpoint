        TerritoryGroup as territory_group,
        cast(SalesQuota as decimal (18,2)) as sales_quota,
        cast(SalesYTD as decimal (18,2)) as sales_ytd,
        cast(SalesLastYear as decimal (18,2)) as sales_last_year
    from source
)

select * from revised
  )

