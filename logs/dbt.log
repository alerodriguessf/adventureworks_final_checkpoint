        create or replace table `ted_dev`.`db_gold`.`fact_sales_order`
      
      
  using delta
      
      
      
      
      
      
      
      as
      with order_detail as (
    select *
    from `ted_dev`.`db_silver`.`stg_sales_order_detail`
),

order_header as (
    select *
    from `ted_dev`.`db_silver`.`stg_sales_order_header`
),

joined as (
    select
        -- Chave do pedido
        od.sales_order_id,
        od.sales_order_detail_id,
        
        -- Chave do produto
        od.product_id,

        -- Cliente e vendedor
        oh.customer_id,
        oh.sales_person_id,
        
        -- Datas relevantes
        oh.order_date,
        oh.due_date,
        oh.ship_date,

        -- Métricas brutas
        od.order_qty,
        od.unit_price,
        od.unit_price_discount,
        
        -- Receita bruta: preço cheio vezes quantidade, menos desconto
        (od.order_qty * od.unit_price * (1 - od.unit_price_discount)) as gross_revenue,

        -- Flags e rastreabilidade
        oh.is_online_order,
        current_timestamp() as ingestion_timestamp

    from order_detail od
    left join order_header oh
        on od.order_id = oh.order_id
)

